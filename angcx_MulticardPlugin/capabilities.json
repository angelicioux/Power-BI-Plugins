    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": {
                        "max": 1
                    },
                    "asAtDate": {
                        "max": 1
                    },
                    "comparison": {
                        "max": 20
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "category"
                    },
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 100
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "values"
                            }
                        },
                        {
                            "bind": {
                                "to": "comparison"
                            }
                        },
                        {
                            "bind": {
                                "to": "comparisonLabel"
                            }
                        },
                        {
                            "bind": {
                                "to": "subHeading"
                            }
                        },
                        {
                            "bind": {
                                "to": "asAtDate"
                            }
                        }
                    ]
                }
            }
        }
