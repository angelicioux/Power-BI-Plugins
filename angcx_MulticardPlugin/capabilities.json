{
    "dataRoles": [
        {
            "displayName": "Values",
            "name": "values",
            "kind": "Measure",
            "description": "One card per measure. Rename the field in this visual (or use Title text) to change the card title."
        },
        {
            "displayName": "Comparison values",
            "name": "comparison",
            "kind": "Measure",
            "description": "Prior year / month / day, target, budget… Each card compares with the measure in the same position by default; choose another per card in Format → Sub value → Compare with."
        },
        {
            "displayName": "Category (one card per item)",
            "name": "category",
            "kind": "Grouping",
            "description": "Optional, e.g. Region – one card per value using the first measure in Values."
        },
        {
            "displayName": "Comparison label (text measure)",
            "name": "comparisonLabel",
            "kind": "Measure",
            "description": "Optional text measure for the sub value label, e.g. driven by a 'Compare to' slicer. Tokens like {year} also work."
        },
        {
            "displayName": "Sub heading (text measure)",
            "name": "subHeading",
            "kind": "Measure",
            "description": "Optional text measure shown under the comparison."
        },
        {
            "displayName": "As-at date",
            "name": "asAtDate",
            "kind": "Measure",
            "description": "Optional, e.g. MAX('Date'[Date]). Fills {year}, {month}, {date} in labels."
        }
    ],
